{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(cat .env)",
      "Bash(type .env)",
      "Bash(Get-Content .env)",
      "PowerShell(Get-Content .env)",
      "PowerShell(cat .env)",
      "PowerShell(type .env)"
    ]
  }
}
